{
  "name": "@isalwa/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed/universe.d.ts",
      "default": "./dist/seed/universe.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"ok\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed:demo": "SEED_PROFILE=${SEED_PROFILE:-demo} tsx src/seed/run.ts",
    "seed:ci": "SEED_PROFILE=ci tsx src/seed/run.ts",
    "seed:full": "SEED_PROFILE=full tsx src/seed/run.ts",
    "seed:validate": "tsx src/seed/validate.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@isalwa/domain": "workspace:*",
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
