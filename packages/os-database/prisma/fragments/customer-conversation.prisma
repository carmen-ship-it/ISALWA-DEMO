/// Manual customer conversation. Evidence the company entered. Not a live channel.
/// Not loaded by schema.prisma. Merge this model there and add
/// `customerConversations OsCustomerConversation[]` on OsOrganization.
/// Do not add payment, stock, delivery, production, or discount confirmation columns.
/// Do not add a phone column. The sales advisor corporate number is WHATSAPP_NUMBER_PENDING.
/// opportunityId, quoteId, and orderId are opaque links. They must not update those rows.
model OsCustomerConversation {
  id                     String    @id
  organizationId         String    @map("organization_id")
  customerId             String    @map("customer_id")
  customerLabel          String    @map("customer_label")
  contactLabel           String?   @map("contact_label")
  channel                String
  occurredAt             DateTime  @map("occurred_at")
  enteredByMemberId      String?   @map("entered_by_member_id")
  enteredByLabel         String    @map("entered_by_label")
  summary                String
  pastedEvidence         String?   @map("pasted_evidence")
  reason                 String?
  /// Who took the conversation. Not the account owner and not a commitment owner.
  assignedMemberId       String?   @map("assigned_member_id")
  assignedLabel          String?   @map("assigned_label")
  assignedAt             DateTime? @map("assigned_at")
  /// Set once the saved next step became an OsCommitment (no foreign key; opaque link).
  nextStepCommitmentId   String?   @map("next_step_commitment_id")
  /// Where the conversation is with the team (Batch 5B). Not an AI state. CHECK-constrained.
  attentionState         String    @default("new") @map("attention_state")
  attentionStateChangedAt DateTime? @map("attention_state_changed_at")
  /// Set when a human took over or changed the state; automated replies stay paused.
  automationPausedAt     DateTime? @map("automation_paused_at")
  opportunityId          String?   @map("opportunity_id")
  quoteId                String?   @map("quote_id")
  orderId                String?   @map("order_id")
  customerQuestion       String?   @map("customer_question")
  commitmentCandidate    String?   @map("commitment_candidate")
  possibleRequestedDate  DateTime? @map("possible_requested_date") @db.Date
  nextAction             String?   @map("next_action")
  source                 String    @default("employee_entered")
  provenance             String    @default("company_entered")
  advisorNumberStatus    String    @default("WHATSAPP_NUMBER_PENDING") @map("advisor_number_status")
  createdAt              DateTime  @default(now()) @map("created_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  notes        OsCustomerConversationNote[]
  stateChanges OsCustomerConversationStateChange[]

  @@index([organizationId, customerId, occurredAt(sort: Desc)])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, assignedMemberId])
  @@map("os_customer_conversations")
}

/// Team-only note on a conversation (Batch 5B "Nota interna / Solo equipo"). Append-only.
/// Never an outbound message: no channel, direction, provider id or delivery column exists.
model OsCustomerConversationNote {
  id             String   @id
  organizationId String   @map("organization_id")
  conversationId String   @map("conversation_id")
  authorMemberId String   @map("author_member_id")
  authorLabel    String   @map("author_label")
  body           String
  visibility     String   @default("team_only")
  /// Browser-generated per draft; repeating a save returns the same note.
  requestKey     String   @map("request_key")
  createdAt      DateTime @default(now()) @map("created_at")

  organization OsOrganization         @relation(fields: [organizationId], references: [id])
  conversation OsCustomerConversation @relation(fields: [conversationId], references: [id])

  @@unique([organizationId, conversationId, authorMemberId, requestKey])
  @@index([organizationId, conversationId, createdAt])
  @@map("os_customer_conversation_notes")
}

/// Append-only history of attention state changes (who, when, from, to, why).
model OsCustomerConversationStateChange {
  id             String   @id
  organizationId String   @map("organization_id")
  conversationId String   @map("conversation_id")
  fromState      String   @map("from_state")
  toState        String   @map("to_state")
  /// take | manual | inbound (inbound is reserved; no inbound path exists yet).
  cause          String
  actorMemberId  String?  @map("actor_member_id")
  changedAt      DateTime @default(now()) @map("changed_at")

  organization OsOrganization         @relation(fields: [organizationId], references: [id])
  conversation OsCustomerConversation @relation(fields: [conversationId], references: [id])

  @@index([organizationId, conversationId, changedAt])
  @@map("os_customer_conversation_state_changes")
}
