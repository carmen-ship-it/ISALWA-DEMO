// Fragment only. Do not apply from this lane.
// Integrator appends these models to schema.prisma and adds on OsOrganization:
//   customerCommittedDates              CustomerCommittedDate[]
//   customerCommittedDateRevisions      CustomerCommittedDateRevision[]
//   productionInternalTargetDates       ProductionInternalTargetDate[]
//   productionInternalTargetRevisions   ProductionInternalTargetRevision[]
//   productionDateIssues                ProductionDateIssue[]
//   customerDateInformedRecords         CustomerDateInformedRecord[]
// Do not add either date as a field on OsOrder. Do not relate the two date models.
// The early warning is not a column and is not a work attention type.

/// Fecha con el cliente. Sales coordinates it. Production knows it.
/// originalCommittedOn and originalReason stay. Revisions do not overwrite them.
model CustomerCommittedDate {
  id                      String   @id
  organizationId          String   @map("organization_id")
  subjectType             String   @map("subject_type")
  subjectId               String   @map("subject_id")
  partyId                 String?  @map("party_id")
  commercialOwnerMemberId String   @map("commercial_owner_member_id")
  committedOn             DateTime @map("committed_on") @db.Date
  originalCommittedOn     DateTime @map("original_committed_on") @db.Date
  originalReason          String   @map("original_reason")
  source                  String   @default("sales_customer_coordination")
  setByMemberId           String   @map("set_by_member_id")
  setAt                   DateTime @map("set_at")
  createdAt               DateTime @default(now()) @map("created_at")

  organization OsOrganization                  @relation(fields: [organizationId], references: [id])
  revisions    CustomerCommittedDateRevision[]

  @@unique([organizationId, subjectType, subjectId])
  @@index([organizationId, commercialOwnerMemberId, committedOn])
  @@map("os_customer_committed_dates")
}

/// Append-only customer-date history. Actor, source, and timestamp stay.
model CustomerCommittedDateRevision {
  id                  String   @id
  committedDateId     String   @map("committed_date_id")
  organizationId      String   @map("organization_id")
  previousCommittedOn DateTime @map("previous_committed_on") @db.Date
  nextCommittedOn     DateTime @map("next_committed_on") @db.Date
  reason              String
  actorMemberId       String   @map("actor_member_id")
  source              String   @default("sales_customer_coordination")
  revisedAt           DateTime @map("revised_at")

  committedDate CustomerCommittedDate @relation(fields: [committedDateId], references: [id])
  organization  OsOrganization        @relation(fields: [organizationId], references: [id])

  @@index([committedDateId, revisedAt])
  @@map("os_customer_committed_date_revisions")
}

/// Fecha interna de producción. Production maintains it. Not copied from the customer date.
model ProductionInternalTargetDate {
  id                   String   @id
  organizationId       String   @map("organization_id")
  subjectType          String   @map("subject_type")
  subjectId            String   @map("subject_id")
  maintainedByMemberId String   @map("maintained_by_member_id")
  targetOn             DateTime @map("target_on") @db.Date
  originalTargetOn     DateTime @map("original_target_on") @db.Date
  originalReason       String   @map("original_reason")
  source               String   @default("production_internal")
  setByMemberId        String   @map("set_by_member_id")
  setAt                DateTime @map("set_at")
  createdAt            DateTime @default(now()) @map("created_at")

  organization OsOrganization                     @relation(fields: [organizationId], references: [id])
  revisions    ProductionInternalTargetRevision[]

  @@unique([organizationId, subjectType, subjectId])
  @@index([organizationId, maintainedByMemberId, targetOn])
  @@map("os_production_internal_target_dates")
}

/// Separate from customer-date revisions. Do not write a customer date here.
model ProductionInternalTargetRevision {
  id               String   @id
  targetDateId     String   @map("target_date_id")
  organizationId   String   @map("organization_id")
  previousTargetOn DateTime @map("previous_target_on") @db.Date
  nextTargetOn     DateTime @map("next_target_on") @db.Date
  reason           String
  actorMemberId    String   @map("actor_member_id")
  source           String   @default("production_internal")
  revisedAt        DateTime @map("revised_at")

  targetDate   ProductionInternalTargetDate @relation(fields: [targetDateId], references: [id])
  organization OsOrganization               @relation(fields: [organizationId], references: [id])

  @@index([targetDateId, revisedAt])
  @@map("os_production_internal_target_date_revisions")
}

/// Explicit human issue. Both flags are recorded. Neither is inferred.
/// No informed column. Customer informed is a different model.
model ProductionDateIssue {
  id                           String   @id
  organizationId               String   @map("organization_id")
  subjectType                  String   @map("subject_type")
  subjectId                    String   @map("subject_id")
  mayAffectProductionCalendar  Boolean  @map("may_affect_production_calendar")
  mayAffectCustomerDate        Boolean  @map("may_affect_customer_date")
  source                       String   @default("human_explicit")
  note                         String?
  recordedByMemberId           String   @map("recorded_by_member_id")
  recordedAt                   DateTime @map("recorded_at")
  createdAt                    DateTime @default(now()) @map("created_at")

  organization    OsOrganization              @relation(fields: [organizationId], references: [id])
  informedRecords CustomerDateInformedRecord[]

  @@index([organizationId, subjectType, subjectId, recordedAt])
  @@map("os_production_date_issues")
}

/// Whether the customer was informed about one issue. Separate from the issue flags.
model CustomerDateInformedRecord {
  id                 String   @id
  issueId            String   @map("issue_id")
  organizationId     String   @map("organization_id")
  subjectType        String   @map("subject_type")
  subjectId          String   @map("subject_id")
  note               String
  recordedByMemberId String   @map("recorded_by_member_id")
  recordedAt         DateTime @map("recorded_at")
  notified           Boolean

  issue        ProductionDateIssue @relation(fields: [issueId], references: [id])
  organization OsOrganization      @relation(fields: [organizationId], references: [id])

  @@index([organizationId, issueId, recordedAt])
  @@map("os_customer_date_informed_records")
}
