// Listo foundation fragment. Merged into schema.prisma.
// A receipt into Almacén de Productos Terminados is not allocation and not a stock ledger.
// Do not add SKU, valuation, cost, tax, FIFO, reservation priority, or an availability formula.
// production_trace_entry_id and quema_id are optional manufacturing citations.
// context_order_id / context_order_line_id are optional Pedido operational citations.
// They are not OrderAllocation and do not assign stock to a Pedido.

model OsFinishedGoodsReceipt {
  id                     String   @id
  organizationId         String   @map("organization_id")
  productId              String   @map("product_id")
  quantity               String
  warehouseLabel         String   @default("Almacén de Productos Terminados") @map("warehouse_label")
  receivedAt             DateTime @map("received_at")
  recordedAt             DateTime @map("recorded_at")
  actorMemberId          String?  @map("actor_member_id")
  actorLabel             String   @map("actor_label")
  source                 String   @default("explicit_command")
  productionTraceEntryId String?  @map("production_trace_entry_id")
  quemaId                String?  @map("quema_id")
  contextOrderId         String?  @map("context_order_id")
  contextOrderLineId     String?  @map("context_order_line_id")
  contextPartyId         String?  @map("context_party_id")
  note                   String?
  correctsReceiptId      String?  @map("corrects_receipt_id")
  correctionReason       String?  @map("correction_reason")
  idempotencyKey         String?  @map("idempotency_key")

  organization OsOrganization @relation(fields: [organizationId], references: [id])

  // Partial unique (organization_id, idempotency_key) WHERE idempotency_key IS NOT NULL
  // is enforced in SQL migrations — keep tenant-scoped idempotent receive durable.
  @@index([organizationId, productId, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([organizationId, contextOrderId, receivedAt])
  @@map("os_finished_goods_receipts")
}
