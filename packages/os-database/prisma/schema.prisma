model OsPurchaseRequestStatusHistory {
  id                String   @id
  organizationId    String   @map("organization_id")
  purchaseRequestId String   @map("purchase_request_id")
  fromStatus        String?  @map("from_status")
  toStatus          String   @map("to_status")
  changedAt         DateTime @map("changed_at")
  actorLabel        String   @map("actor_label")
  actorMemberId     String?  @map("actor_member_id")
  source            String   @default("manual")
  note              String?

  purchaseRequest OsPurchaseRequest @relation(fields: [purchaseRequestId], references: [id])

  @@index([organizationId, purchaseRequestId, changedAt])
  @@map("os_purchase_request_status_history")
}

/// Notes and evidence references. A reference is not a stock reading.
model OsPurchaseRequestNote {
  id                 String   @id
  organizationId     String   @map("organization_id")
  purchaseRequestId  String   @map("purchase_request_id")
  body               String
  recordedAt         DateTime @map("recorded_at")
  actorLabel         String   @map("actor_label")
  actorMemberId      String?  @map("actor_member_id")
  source             String   @default("manual")
  evidenceReference  String?  @map("evidence_reference")

  purchaseRequest OsPurchaseRequest @relation(fields: [purchaseRequestId], references: [id])

  @@index([organizationId, purchaseRequestId, recordedAt])
  @@map("os_purchase_request_notes")
}

// fragment: price-list.prisma
model OsPriceList {
  organizationId String    @map("organization_id")
  id             String
  version        String
  currency       String
  effectiveFrom  DateTime  @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  sourceFilename String    @map("source_filename")
  sourceSha256   String    @map("source_sha256")
  sourcePage     Int?      @map("source_page")
  sourceExcerpt  String    @map("source_excerpt")
  printedContext String    @map("printed_context")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  entries      OsPriceEntry[]

  @@id([organizationId, id])
  @@unique([organizationId, version])
  @@index([organizationId, effectiveFrom])
  @@map("os_price_lists")
}

/// One sourced amount in one context. Not the advisor quoted price.
model OsPriceEntry {
  organizationId String   @map("organization_id")
  id             String
  priceListId    String   @map("price_list_id")
  productId      String   @map("product_id")
  context        String
  currency       String
  amountCentavos BigInt   @map("amount_centavos")
  sourceFilename String   @map("source_filename")
  sourceSha256   String   @map("source_sha256")
  sourcePage     Int?     @map("source_page")
  sourceExcerpt  String   @map("source_excerpt")
  printedContext String   @map("printed_context")
  createdAt      DateTime @default(now()) @map("created_at")

  organization OsOrganization   @relation(fields: [organizationId], references: [id])
  priceList    OsPriceList      @relation(fields: [organizationId, priceListId], references: [organizationId, id])
  product      OsCatalogProduct @relation(fields: [organizationId, productId], references: [organizationId, id])

  @@id([organizationId, id])
  @@unique([organizationId, priceListId, productId, context])
  @@index([organizationId, productId])
  @@map("os_price_entries")
}

// fragment: special-order.prisma
model OsSpecialOrderClassification {
  id                                 String   @id
  organizationId                     String   @map("organization_id")
  orderId                            String   @map("order_id")
  classification                     String
  requiresProductionPlanning         Boolean  @map("requires_production_planning")
  actorMemberId                      String?  @map("actor_member_id")
  actorLabel                         String   @map("actor_label")
  source                             String
  recordedAt                         DateTime @map("recorded_at")
  previousClassification             String?  @map("previous_classification")
  previousRequiresProductionPlanning Boolean? @map("previous_requires_production_planning")
  createdAt                          DateTime @default(now()) @map("created_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, orderId, recordedAt])
  @@map("os_special_order_classifications")
}

// Customer coverage: one primary owner, one acting advisor, resource-specific.
// Not shared ownership. Not GrantDelegation. Not convert.own.
model OsCustomerCoverageGrant {
  id                    String    @id
  organizationId        String    @map("organization_id")
  customerPartyId       String    @map("customer_party_id")
  primaryOwnerMemberId  String    @map("primary_owner_member_id")
  actingAdvisorMemberId String    @map("acting_advisor_member_id")
  grantType             String    @default("commercial.customer.coverage") @map("grant_type")
  startsAt              DateTime  @map("starts_at")
  endsAt                DateTime? @map("ends_at")
  revokedAt             DateTime? @map("revoked_at")
  recordedAt            DateTime  @map("recorded_at")
  recordedByMemberId    String?   @map("recorded_by_member_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, customerPartyId, actingAdvisorMemberId, startsAt], map: "os_customer_coverage_grants_lookup_idx")
  @@index([organizationId, customerPartyId, primaryOwnerMemberId], map: "os_customer_coverage_grants_owner_idx")
  @@map("os_customer_coverage_grants")
}

// fragment: coordination-decision.prisma
model OsCoordinationDecision {
  id                   String    @id
  organizationId       String    @map("organization_id")
  kind                 String    @default("recorded")
  decision             String
  ownerLabel           String?   @map("owner_label")
  ownerMemberId        String?   @map("owner_member_id")
  /// Caller-provided date or instant. Not a meeting slot. Stored as text so a date is not rewritten.
  dueAt                String?   @map("due_at")
  actorLabel           String    @map("actor_label")
  actorMemberId        String?   @map("actor_member_id")
  occurredAt           DateTime  @map("occurred_at")
  linkedCaseId         String?   @map("linked_case_id")
  notes                String?
  resolvesDecisionId   String?   @map("resolves_decision_id")
  recordedAt           DateTime  @map("recorded_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, occurredAt])
  @@index([organizationId, kind])
  @@map("os_coordination_decisions")
}

// Issue Memory models. Wave B addition.

/// Central issue record. Status lifecycle is open → [investigating → confirmed] → resolved → closed.
/// Reopening creates a new resolution cycle row.
model OsIssue {
  id                          String    @id
  organizationId              String    @map("organization_id")
  version                     Int       @default(0)
  status                      String
  title                       String?
  description                 String
  reportedByMemberId          String    @map("reported_by_member_id")
  reportedAt                  DateTime  @map("reported_at")
  currentOwnerMemberId        String?   @map("current_owner_member_id")
  confirmedCause              String?   @map("confirmed_cause")
  confirmedCauseByMemberId    String?   @map("confirmed_cause_by_member_id")
  confirmedCauseAt            DateTime? @map("confirmed_cause_at")
  resolution                  String?
  resolvedByMemberId          String?   @map("resolved_by_member_id")
  resolvedAt                  DateTime? @map("resolved_at")
  outcome                     String?
  outcomeRecordedByMemberId   String?   @map("outcome_recorded_by_member_id")
  outcomeRecordedAt           DateTime? @map("outcome_recorded_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  organization       OsOrganization            @relation(fields: [organizationId], references: [id])
  references         OsIssueReference[]
  journalEntries     OsIssueJournalEntry[]
  workLinks          OsIssueWorkLink[]
  relationsFrom      OsIssueRelation[]         @relation("IssueRelationFrom")
  relationsTo        OsIssueRelation[]         @relation("IssueRelationTo")
  resolutionCycles   OsIssueResolutionCycle[]
  ownershipHistory   OsIssueOwnershipHistory[]

  @@index([organizationId, status])
  @@index([organizationId, currentOwnerMemberId])
  @@index([organizationId, reportedByMemberId])
  @@index([organizationId, createdAt])
  @@map("os_issues")
}

/// External entity reference linked to an issue (order, party, quote, etc.).
model OsIssueReference {
  id                  String   @id
  organizationId      String   @map("organization_id")
  issueId             String   @map("issue_id")
  referenceType       String   @map("reference_type")
  referenceId         String   @map("reference_id")
  createdAt           DateTime @default(now()) @map("created_at")
  createdByMemberId   String   @map("created_by_member_id")

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  issue        OsIssue        @relation(fields: [issueId], references: [id])

  @@unique([organizationId, issueId, referenceType, referenceId])
  @@index([organizationId, referenceType, referenceId])
  @@map("os_issue_references")
}

/// Append-only journal entry for issue activity (comments, status changes, etc.).
model OsIssueJournalEntry {
  id               String   @id
  organizationId   String   @map("organization_id")
  issueId          String   @map("issue_id")
  entryType        String   @map("entry_type")
  content          String
  authorMemberId   String   @map("author_member_id")
  recordedAt       DateTime @map("recorded_at")
  provenance       String?

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  issue        OsIssue        @relation(fields: [issueId], references: [id])

  @@index([issueId, recordedAt])
  @@map("os_issue_journal_entries")
}

/// Links an issue to a work item (task).
model OsIssueWorkLink {
  id                String   @id
  organizationId    String   @map("organization_id")
  issueId           String   @map("issue_id")
  workItemId        String   @map("work_item_id")
  linkedByMemberId  String   @map("linked_by_member_id")
  linkedAt          DateTime @map("linked_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  issue        OsIssue        @relation(fields: [issueId], references: [id])

  @@unique([organizationId, issueId, workItemId])
  @@map("os_issue_work_links")
}

/// Issue-to-issue relationship (blocks, duplicates, relates_to, etc.).
model OsIssueRelation {
  id                 String   @id
  organizationId     String   @map("organization_id")
  fromIssueId        String   @map("from_issue_id")
  toIssueId          String   @map("to_issue_id")
  relationType       String   @map("relation_type")
  createdByMemberId  String   @map("created_by_member_id")
  createdAt          DateTime @default(now()) @map("created_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  fromIssue    OsIssue        @relation("IssueRelationFrom", fields: [fromIssueId], references: [id])
  toIssue      OsIssue        @relation("IssueRelationTo", fields: [toIssueId], references: [id])

  @@unique([organizationId, fromIssueId, toIssueId, relationType])
  @@map("os_issue_relations")
}

/// Append-only resolution cycle for reopen/resolve history.
model OsIssueResolutionCycle {
  id                          String    @id
  organizationId              String    @map("organization_id")
  issueId                     String    @map("issue_id")
  cycleIndex                  Int       @map("cycle_index")
  confirmedCause              String?   @map("confirmed_cause")
  confirmedCauseByMemberId    String?   @map("confirmed_cause_by_member_id")
  confirmedCauseAt            DateTime? @map("confirmed_cause_at")
  resolution                  String?
  resolvedByMemberId          String?   @map("resolved_by_member_id")
  resolvedAt                  DateTime? @map("resolved_at")
  outcome                     String?
  outcomeRecordedByMemberId   String?   @map("outcome_recorded_by_member_id")
  outcomeRecordedAt           DateTime? @map("outcome_recorded_at")
  closedAt                    DateTime? @map("closed_at")
  closedByMemberId            String?   @map("closed_by_member_id")
  reopenedAt                  DateTime? @map("reopened_at")
  reopenedByMemberId          String?   @map("reopened_by_member_id")
  recordedAt                  DateTime  @map("recorded_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  issue        OsIssue        @relation(fields: [issueId], references: [id])

  @@index([issueId, cycleIndex])
  @@map("os_issue_resolution_cycles")
}

/// In-app product feedback submitted by members.
model OsProductFeedback {
  id             String   @id
  organizationId String   @map("organization_id")
  memberId       String   @map("member_id")
  route          String
  message        String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization OsOrganization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("os_product_feedback")
}

/// Audit trail for issue ownership changes.
model OsIssueOwnershipHistory {
  id                String   @id
  organizationId    String   @map("organization_id")
  issueId           String   @map("issue_id")
  fromMemberId      String?  @map("from_member_id")
  toMemberId        String   @map("to_member_id")
  changedByMemberId String   @map("changed_by_member_id")
  changedAt         DateTime @map("changed_at")
  reason            String?

  organization OsOrganization @relation(fields: [organizationId], references: [id])
  issue        OsIssue        @relation(fields: [issueId], references: [id])

  @@index([issueId, changedAt])
  @@map("os_issue_ownership_history")
}
