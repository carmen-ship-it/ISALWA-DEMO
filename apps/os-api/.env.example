# ISALWA OS API — environment template (copy to host env / .env.local — never commit secrets)

# Runtime profile: development | staging | production
# OS_RUNTIME_PROFILE=development

# Auth: dev (local only) | supabase (staging/production)
OS_AUTH_MODE=dev

# Authoritative OS database — NOT legacy DATABASE_URL
# OS_DATABASE_URL=postgresql://isalwa:isalwa@localhost:5432/isalwa

# Supabase (required when OS_AUTH_MODE=supabase)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only admin ops

# API bind (host PORT wins when set — Render/etc.)
# PORT=4001
# OS_API_PORT=4001
# OS_API_HOST=0.0.0.0

# CORS exact-origin allowlist (comma-separated; no wildcard).
# Required for staging/production. Development defaults to http://localhost:3200 when unset.
# OS_CORS_ORIGINS=http://localhost:3200
# External demo example:
# OS_CORS_ORIGINS=https://isalwa-demo.vercel.app

# Outbox worker (co-hosted). Set 0 to disable polling.
# OS_OUTBOX_WORKER=1
# OS_OUTBOX_POLL_MS=5000
# OS_OUTBOX_BATCH_SIZE=25
