# Environment for ISALWA Architect
#
# Copy to `.env.local` for local development.
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible) — optional
# When unset, Architect uses LocalHeuristicProvider (deterministic, no network).
# ---------------------------------------------------------------------------
ARCHITECT_LLM_API_KEY=
ARCHITECT_LLM_BASE_URL=https://api.openai.com/v1
ARCHITECT_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase Auth (Mission 10)
# When URL + anon key are set → real Supabase email/password auth.
# When unset → pilot cookie auth with seeded Carmen / Álvaro accounts.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides for pilot passwords (defaults: Architect2026!)
ARCHITECT_PILOT_CARMEN_PASSWORD=
ARCHITECT_PILOT_ALVARO_PASSWORD=

# ---------------------------------------------------------------------------
# Optional public site URL (absolute links / OG when needed)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ARCHITECT_URL=
