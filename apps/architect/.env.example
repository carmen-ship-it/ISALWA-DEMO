# Environment for ISALWA Architect
#
# Copy to `.env.local` for local development.
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# AI provider (see apps/architect/AI_PROVIDER_ABSTRACTION.md) — optional
#
# When no key is configured, Architect uses a deterministic LocalHeuristicProvider
# (no network, no fabricated answers). Nothing else hardcodes a model or vendor —
# every AI call reads AI_CONFIG (lib/ai/config.ts), which reads these variables.
#
# ARCHITECT_LLM_PROVIDER is optional — "gemini" | "openai" | "anthropic" | "local".
# When unset, the provider is inferred from ARCHITECT_LLM_BASE_URL, falling back
# to "openai" if a key is set with no recognizable base URL.
#
# Google Gemini (OpenAI-compatible endpoint) — current default for this app:
#   ARCHITECT_LLM_PROVIDER=gemini
#   ARCHITECT_LLM_API_KEY=<your Gemini API key from AI Studio>
#   ARCHITECT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   ARCHITECT_LLM_MODEL=gemini-flash-latest
#
# OpenAI:
#   ARCHITECT_LLM_PROVIDER=openai
#   ARCHITECT_LLM_API_KEY=sk-...
#   ARCHITECT_LLM_BASE_URL=https://api.openai.com/v1
#   ARCHITECT_LLM_MODEL=gpt-4o-mini
#
# Anthropic (chat only — no embeddings API; see lib/ai/anthropic.ts):
#   ARCHITECT_LLM_PROVIDER=anthropic
#   ARCHITECT_LLM_API_KEY=sk-ant-...
#   ARCHITECT_LLM_MODEL=claude-3-5-haiku-latest
#
# These are also the fallback key/base URL for the OCR and embeddings routes
# (ARCHITECT_OCR_*, ARCHITECT_EMBEDDINGS_* below override them per-route).
# ---------------------------------------------------------------------------
ARCHITECT_LLM_PROVIDER=
ARCHITECT_LLM_API_KEY=
ARCHITECT_LLM_BASE_URL=
ARCHITECT_LLM_MODEL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase Auth + shared company memory (ISALWA pilot)
#
# When URL + anon key are set:
#   - Auth: Supabase email/password (Carmen / Álvaro created in dashboard)
#   - Persistence: Supabase JSONB (workspaces, conversations, interviews)
#   - Local Storage is NOT required
#
# When unset:
#   - Auth: pilot cookie (seeded Carmen / Álvaro passwords below)
#   - Persistence: browser localStorage (solo/dev only)
#
# Setup steps: supabase/OPERATOR_GUIDE.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides for pilot cookie passwords (defaults: Architect2026!)
# Ignored when Supabase Auth is configured (passwords live in Supabase).
ARCHITECT_PILOT_CARMEN_PASSWORD=
ARCHITECT_PILOT_ALVARO_PASSWORD=

# ---------------------------------------------------------------------------
# Optional public site URL (absolute links / OG when needed)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ARCHITECT_URL=

# ---------------------------------------------------------------------------
# Real Integrations — connectors (see apps/architect/MISSION23.md)
#
# Google Drive is the one LIVE connector: OAuth + list/import files into the
# existing document/intake pipeline. Requires Supabase configured above
# (tokens are stored in architect_connector_credentials, RLS-protected,
# consultant-only — see supabase/migrations/004_connector_credentials.sql).
# Without these two set, the connectors panel shows an honest
# "not configured" state and makes no network call.
#
# Create credentials: Google Cloud Console → APIs & Services → Credentials
# → OAuth client ID (Web application). Authorized redirect URI:
#   <your deployment origin>/api/connectors/google-drive/callback
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=
# Server-only — never prefix with NEXT_PUBLIC_
GOOGLE_DRIVE_CLIENT_SECRET=
# Optional — only needed if it must differ from
# <deployment origin>/api/connectors/google-drive/callback
GOOGLE_DRIVE_REDIRECT_URI=

# SharePoint / Microsoft 365 — SCAFFOLDED ONLY (catalog entry + honest
# not-connected UI). No OAuth flow exists yet; setting these has no effect.
MICROSOFT_365_CLIENT_ID=
MICROSOFT_365_CLIENT_SECRET=
MICROSOFT_365_TENANT_ID=

# QuickBooks — SCAFFOLDED ONLY. No OAuth flow exists yet; setting these has
# no effect.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# HubSpot — SCAFFOLDED ONLY. No OAuth flow exists yet; setting these has no
# effect.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Autonomous Consulting Cycle — scheduled overnight review
# (see apps/architect/MISSION24.md)
#
# Vercel Cron (vercel.json → "crons") calls GET /api/cron/consulting-review
# once nightly. That route re-runs the same runConsultingIntelligenceCycle
# every interview answer/document upload already triggers — no new agent,
# no fake insight — for every workspace that is due, and writes an honest
# Spanish "what changed overnight" digest.
#
# CRON_SECRET — set this to a random string (16+ chars). Vercel automatically
# sends it as `Authorization: Bearer <CRON_SECRET>` on every Cron invocation;
# the route rejects any request without a matching header. Without this set,
# the endpoint always answers 401 — there is no insecure fallback.
CRON_SECRET=
#
# The cron route has no signed-in user, so it cannot use the normal RLS-backed
# write path (docs/SECURITY_POSTURE.md §1) — it authenticates as the Supabase
# project itself via SUPABASE_SERVICE_ROLE_KEY (already declared above; this
# is the first code path in the app that actually reads it — see
# docs/SECURITY_POSTURE.md §5). Without NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY set, the route responds with an honest no-op
# (nothing to review yet), never an error.
# ---------------------------------------------------------------------------
