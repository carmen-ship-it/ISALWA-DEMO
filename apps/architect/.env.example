# Environment for ISALWA Architect
#
# Copy to `.env.local` for local development.
# On Vercel, set the same keys in Project → Settings → Environment Variables.
#
# All keys are optional today: Architect runs on the local heuristic LLM
# and local/browser company memory without any secrets configured.

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible) — optional
# When unset, Architect uses LocalHeuristicProvider (deterministic, no network).
# ---------------------------------------------------------------------------
ARCHITECT_LLM_API_KEY=
ARCHITECT_LLM_BASE_URL=https://api.openai.com/v1
ARCHITECT_LLM_MODEL=gpt-4o-mini

# Alias accepted by the provider factory (same as ARCHITECT_LLM_API_KEY)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Future Supabase persistence — not wired yet (local/memory store today)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional public site URL (for absolute links / OG when added later)
# Use the Vercel production URL in production. Leave empty locally.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ARCHITECT_URL=
