# Development — no Supabase required
NEXT_PUBLIC_OS_AUTH_MODE=dev
NEXT_PUBLIC_OS_API_URL=http://localhost:4001/v1

# Production Supabase (uncomment and fill)
# NEXT_PUBLIC_OS_AUTH_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_OS_API_URL=

# Protected evaluation walkthrough (Vercel isalwa-os-web-evaluation)
# OS_RUNTIME_PROFILE=evaluation
# OS_EVALUATION_WALKTHROUGH_ONLY=1
# Server-only comma-separated allowlist (never NEXT_PUBLIC_):
# ISALWA_EVALUATOR_EMAILS=
