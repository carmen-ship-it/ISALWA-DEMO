# Do not set NODE_ENV in .env for cloud builds — scripts set production.
APP_VERSION=0.1.0

NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
# Demo preview uses mock messaging/maps/AI until live credentials exist
ALLOW_MOCK_PROVIDERS=1

# Prefer Carmen Cursor XL cloud Postgres — tunnel, do not install Postgres locally.
# ssh -L 5433:127.0.0.1:5432 carmen-aws-dev
DATABASE_URL=postgresql://isalwa_app:CHANGE_ME@127.0.0.1:5433/isalwa?schema=public

REDIS_URL=redis://localhost:6379
SEED_PROFILE=demo
SEED_KEY=isalwa-universe-v1
SEED_AS_OF=2026-07-24T12:00:00.000Z

MESSAGING_PROVIDER=mock
MAPS_PROVIDER=mock
# Territory GIS (Mission 16): mapbox | mock
# NEXT_PUBLIC_MAPS_PROVIDER=mapbox
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.…
# MAPBOX_ACCESS_TOKEN=pk.…   # server geocode (optional)
AI_PROVIDER=mock
# OS assistive AI (server only). Off unless AI_ENABLED=true.
# AI_ENABLED=false
# OPENAI_ISALWA_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_FALLBACK_MODEL=
# AI_MODEL_ALLOWLIST=gpt-4o-mini
# AI_REQUEST_TIMEOUT_MS=20000
# AI_MAX_PROVIDER_RETRIES=1
# AI_MAX_OUTPUT_TOKENS=800
# AI_MAX_EVIDENCE_ITEMS=50
# AI_MEMBER_RATE_LIMIT_PER_MINUTE=6
# AI_MEMBER_RATE_LIMIT_PER_HOUR=30
# AI_ORG_RATE_LIMIT_PER_DAY=250
# AI_MEMBER_MAX_CONCURRENCY=1
# AI_ORG_MAX_CONCURRENCY=5
# AI_MONTHLY_BUDGET_USD=20

# Staging QA Control Center / Ver Como. Production must leave unset/false.
# OS_QA_CONTROL_ENABLED=false
# OS_QA_SIGNING_SECRET=
STORAGE_PROVIDER=mock
SEARCH_PROVIDER=mock
PDF_PROVIDER=mock
EMAIL_PROVIDER=mock
