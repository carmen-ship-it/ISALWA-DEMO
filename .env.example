# Do not set NODE_ENV in .env for cloud builds — scripts set production.
APP_VERSION=0.1.0-m4

NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
# Demo preview uses mock messaging/maps/AI until live credentials exist
ALLOW_MOCK_PROVIDERS=1

# Prefer Carmen Cursor XL cloud Postgres — tunnel, do not install Postgres locally.
# ssh -L 5433:127.0.0.1:5432 carmen-aws-dev
DATABASE_URL=postgresql://isalwa_app:CHANGE_ME@127.0.0.1:5433/isalwa?schema=public

REDIS_URL=redis://localhost:6379
SEED_PROFILE=demo
SEED_KEY=isalwa-universe-v1
SEED_AS_OF=2026-07-24T12:00:00.000Z

MESSAGING_PROVIDER=mock
MAPS_PROVIDER=mock
AI_PROVIDER=mock
STORAGE_PROVIDER=mock
SEARCH_PROVIDER=mock
PDF_PROVIDER=mock
EMAIL_PROVIDER=mock
