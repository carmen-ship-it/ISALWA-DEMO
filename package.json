{
  "name": "isalwa",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @isalwa/web dev",
    "dev:api": "pnpm --filter @isalwa/api dev",
    "dev:os-api": "pnpm --filter @isalwa/os-api dev",
    "dev:architect": "pnpm --filter @isalwa/architect dev",
    "dev:os-web": "pnpm --filter @isalwa/os-web dev",
    "build:architect": "pnpm --filter @isalwa/architect build",
    "dev:deps": "docker compose -f docker/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @isalwa/database migrate:deploy",
    "seed:demo": "pnpm --filter @isalwa/database seed:demo",
    "seed:ci": "pnpm --filter @isalwa/database seed:ci",
    "seed:validate": "pnpm --filter @isalwa/database seed:validate",
    "format": "prettier --write .",
    "fixture:wave2-roles:prepare": "corepack pnpm --filter @isalwa/os-database^... run build",
    "fixture:wave2-roles": "corepack pnpm run fixture:wave2-roles:prepare && corepack pnpm --filter @isalwa/os-database run fixture:wave2-roles",
    "fixture:owner-demo:prepare": "corepack pnpm --filter @isalwa/os-database^... run build",
    "fixture:owner-demo": "corepack pnpm run fixture:owner-demo:prepare && STAGING_FIXTURE_CONFIRM=1 corepack pnpm --filter @isalwa/os-database run fixture:owner-demo",
    "fixture:owner-demo:conversations-dry-run": "corepack pnpm --filter @isalwa/os-database run fixture:owner-demo:conversations-dry-run",
    "fixture:owner-demo:journey-customer": "corepack pnpm --filter @isalwa/os-database run fixture:owner-demo:journey-customer"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
