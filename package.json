{
  "name": "isalwa",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @isalwa/web dev",
    "dev:api": "pnpm --filter @isalwa/api dev",
    "dev:deps": "docker compose -f docker/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @isalwa/database migrate:deploy",
    "seed:demo": "pnpm --filter @isalwa/database seed:demo",
    "seed:ci": "pnpm --filter @isalwa/database seed:ci",
    "seed:validate": "pnpm --filter @isalwa/database seed:validate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
